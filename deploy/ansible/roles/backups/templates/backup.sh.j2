#!/bin/bash
# Regenerated by Ansible (deploy/ansible/roles/backups) - do not edit by hand.
#
# `sqlite3 <db> ".backup <dest>"` is SQLite's own safe way to snapshot a
# live, WAL-mode database - unlike `cp`, it takes the brief lock it
# actually needs to get a consistent copy instead of copying bytes that
# might be mid-write. This is the answer to a question the single-EBS-
# volume design otherwise leaves open: nothing backed up this database
# before this role existed.
set -euo pipefail

DB="{{ data_dir }}/mini.db"
STAGING="/var/backups/mini-chat"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
SNAPSHOT="${STAGING}/mini-${STAMP}.db"

mkdir -p "$STAGING"

if [ ! -f "$DB" ]; then
  echo "no database at $DB yet - nothing to back up"
  exit 0
fi

sqlite3 "$DB" ".backup '${SNAPSHOT}'"
gzip "$SNAPSHOT"

aws s3 cp "${SNAPSHOT}.gz" "s3://{{ backups_bucket }}/mini-${STAMP}.db.gz" \
  --region "{{ aws_region }}"

# Local copies are a fast-restore convenience, not the durable record - S3
# is. Keep only the last {{ backups_retention_days }} days on disk.
find "$STAGING" -name 'mini-*.db.gz' -mtime +{{ backups_retention_days }} -delete

echo "backed up ${DB} to s3://{{ backups_bucket }}/mini-${STAMP}.db.gz"
