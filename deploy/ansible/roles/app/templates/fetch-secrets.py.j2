#!/usr/bin/env python3
"""
Regenerated by Ansible on every deploy (deploy/ansible/roles/app) - do not
edit by hand, it will be overwritten.

Pulls every parameter under {{ ssm_parameter_path }} from SSM Parameter
Store using the instance's own IAM role (nothing on the controller needs
read access to these secrets; only the instance does, scoped to exactly
this path - see deploy/terraform/iam.tf) and writes them as a systemd
EnvironmentFile. The file is written with 0600 permissions from the first
byte - there is no window where it exists world-readable.
"""
import json
import os
import subprocess
import sys

PATH = "{{ ssm_parameter_path }}"
REGION = "{{ aws_region }}"
OUT = "{{ secrets_env_file }}"


def fetch_parameters():
    params, next_token = [], None
    while True:
        cmd = [
            "aws", "ssm", "get-parameters-by-path",
            "--path", PATH,
            "--with-decryption",
            "--recursive",
            "--region", REGION,
            "--max-results", "50",
            "--output", "json",
        ]
        if next_token:
            cmd += ["--starting-token", next_token]

        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if result.returncode != 0:
            sys.exit(f"aws ssm get-parameters-by-path failed: {result.stderr.strip()}")

        page = json.loads(result.stdout)
        params.extend(page.get("Parameters", []))
        next_token = page.get("NextToken")
        if not next_token:
            return params


def main():
    params = fetch_parameters()
    if not params:
        print(f"warning: no parameters found under {PATH} - the app will run "
              f"with no secrets at all (no ANTHROPIC_API_KEY!). See deploy/README.md.",
              file=sys.stderr)

    lines = []
    for p in params:
        key = p["Name"].rsplit("/", 1)[-1]
        value = p["Value"]
        if "\n" in value:
            sys.exit(f"parameter {p['Name']} contains a newline - that breaks "
                      f"systemd's EnvironmentFile format, refusing to write it")
        lines.append(f"{key}={value}")

    tmp_path = OUT + ".tmp"
    fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(lines) + "\n" if lines else "")
    except Exception:
        os.unlink(tmp_path)
        raise
    os.chmod(tmp_path, 0o600)  # belt and braces against an inherited umask
    os.replace(tmp_path, OUT)  # atomic on the same filesystem - no partial file is ever visible
    print(f"wrote {len(lines)} parameter(s) to {OUT}")


if __name__ == "__main__":
    main()
