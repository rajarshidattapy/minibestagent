# Copy to .env and fill in. Never commit the real values.

# --- required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- authentication ---------------------------------------------------------
# Set both to require a signed OAuth2 / OIDC access token on /api/chat.
# Every request is then checked for signature, issuer, audience and expiry.
#
# OIDC_ISSUER must match the `iss` claim byte for byte, trailing slash included
# (Auth0 has one, most others do not).
# OIDC_AUDIENCE must match the `aud` claim - the API identifier, not the client id.
OIDC_ISSUER=https://your-tenant.example.com/
OIDC_AUDIENCE=https://api.your-app.example

# Only needed if the issuer has no /.well-known/openid-configuration document.
# OIDC_JWKS_URI=https://your-tenant.example.com/.well-known/jwks.json

# Leave the two OIDC_ variables unset to run without authentication. That is
# allowed in development; in production it requires typing this out in full,
# so a forgotten variable can never silently expose an open endpoint.
# AUTH_OPTIONAL=true

# --- browser sign-in (Authorization Code + PKCE) -----------------------------
# NEXT_PUBLIC_* values are baked into the client bundle at build time, so put
# nothing secret here. PKCE needs no client secret.
# Register https://your-app.example/auth/callback as an allowed redirect URI.
NEXT_PUBLIC_OIDC_ISSUER=https://your-tenant.example.com/
NEXT_PUBLIC_OIDC_CLIENT_ID=your-spa-client-id
NEXT_PUBLIC_OIDC_AUDIENCE=https://api.your-app.example
# offline_access is what gets you a refresh token; drop it if your IdP objects.
NEXT_PUBLIC_OIDC_SCOPE=openid profile offline_access

# --- response cache ---------------------------------------------------------
# Model responses are cached in the same SQLite file as conversation memory,
# keyed on a hash of the prompt with the clock scrubbed to day precision.
# Only the hash is stored, never the prompt text.
#
# Searched answers live 15 minutes, unsearched ones 12 hours - this agent's
# job is to be current, so anything built from a web search goes stale fast.
# LLM_CACHE=off
#
# Owner-scoped by default. "global" shares identical cold-start questions
# across users: sound, since an identical prompt implies an identical answer,
# but it stops being obviously safe the moment the prompt gains a new field.
# LLM_CACHE_SCOPE=global

# Where conversation memory and the cache are stored.
# MEMORY_DB_PATH=./data/mini.db
