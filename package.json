{
  "name": "mini-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "verify:oidc": "node scripts/verify-oidc.mjs",
    "verify:guardrails": "node scripts/verify-guardrails.mjs",
    "lint": "next lint",
    "verify:memory": "node scripts/verify-memory.mjs",
    "verify": "npm run verify:memory && npm run verify:cache && npm run verify:rbac && npm run verify:metrics && npm run verify:oidc && npm run verify:guardrails",
    "verify:cache": "node scripts/verify-cache.mjs",
    "verify:rbac": "node scripts/verify-rbac.mjs",
    "verify:metrics": "node scripts/verify-metrics.mjs",
    "eval": "node evals/run.mjs",
    "eval:live": "node evals/run.mjs --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prometheus-io/client": "^0.16.1",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
